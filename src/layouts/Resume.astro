---
import { render, type CollectionEntry } from 'astro:content';
import '../styles/global.css';
import '../styles/print.css';

interface Props {
  entry: CollectionEntry<'resume'>;
  altHref: string;
}

const { entry, altHref } = Astro.props;
const { lang, name, title, location, contacts, ui } = entry.data;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const pdfHref = `${base}resume_${lang}.pdf`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name}</title>
    <meta name="description" content={`${name}, ${title}. ${location}`} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <script is:inline>
      try { if (localStorage.getItem('mono') === '1') document.documentElement.dataset.mono = '1'; } catch {}
    </script>
  </head>
  <body>
    <canvas id="scene" aria-hidden="true"></canvas>

    <main class="page">
      <header class="head">
        <div class="head-top">
          <p class="prompt"><span class="ps">$</span> cat resume.md<span class="cursor" aria-hidden="true">█</span></p>
          <nav class="actions" aria-label="Actions">
            <button class="btn" id="hide" type="button" title="hide text, show only the scene (Esc)">hide</button>
            <button class="btn" id="mono" type="button" aria-pressed="false" title="monochrome">mono</button>
            <a class="btn" href={altHref} hreflang={lang === 'en' ? 'ru' : 'en'}>{ui.switchTo}</a>
            <a class="btn btn-primary" href={pdfHref} download>{ui.pdf} ↓</a>
          </nav>
        </div>
        <h1>{name}</h1>
        <p class="role">{title} <span class="muted">· {location}</span></p>
        <dl class="contacts">
          <div><dt>{ui.phone}</dt><dd><a href={`tel:${contacts.phone.replace(/[^+\d]/g, '')}`}>{contacts.phone}</a></dd></div>
          <div><dt>telegram</dt><dd><a href={`https://t.me/${contacts.telegram}`}>@{contacts.telegram}</a></dd></div>
          <div><dt>email</dt><dd><a href={`mailto:${contacts.email}`}>{contacts.email}</a></dd></div>
          <div><dt>linkedin</dt><dd><a href={`https://www.linkedin.com/in/${contacts.linkedin}/`}>in/{contacts.linkedin}</a></dd></div>
          <div><dt>github</dt><dd><a href={`https://github.com/${contacts.github}`}>{contacts.github}</a></dd></div>
        </dl>
      </header>

      <article class="prose">
        <Content />
      </article>
    </main>

    <button class="btn unhide" id="unhide" type="button" hidden>show</button>

    <script>
      import '../scene/main.js';

      const btn = document.getElementById('mono');
      const root = document.documentElement;
      const sync = () => btn?.setAttribute('aria-pressed', String(root.dataset.mono === '1'));
      sync();
      btn?.addEventListener('click', () => {
        if (root.dataset.mono === '1') delete root.dataset.mono;
        else root.dataset.mono = '1';
        try { localStorage.setItem('mono', root.dataset.mono === '1' ? '1' : '0'); } catch {}
        sync();
        window.dispatchEvent(new Event('mono-change'));
      });

      // hide the text and leave just the scene
      const unhide = document.getElementById('unhide');
      const setHidden = (on) => {
        if (on) root.dataset.hide = '1';
        else delete root.dataset.hide;
        if (unhide) unhide.hidden = !on;
        (on ? unhide : document.getElementById('hide'))?.focus({ preventScroll: true });
      };
      document.getElementById('hide')?.addEventListener('click', () => setHidden(true));
      unhide?.addEventListener('click', () => setHidden(false));
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setHidden(root.dataset.hide !== '1');
      });
    </script>
  </body>
</html>
